              <span>Auto-refreshing every 10s</span>
              <button
                onClick={() => showToast('Log Stream', 'Full log archive exported.', 'info')}
                className="hover:text-white text-[11px] underline"
              >
                Download Archive
              </button>
            </div>
          </div>
        </div>
      </div>
    </AdminLayout>
  );
};
