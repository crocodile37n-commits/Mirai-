import React, { createContext, useContext, useState, useEffect, ReactNode } from 'react';
import { AnimeMedia, UserProfile, UserSettings, WatchProgress, CommentItem } from '../types';
import { FALLBACK_SPOTLIGHT, FALLBACK_TRENDING } from '../services/animeApi';

interface NavigationState {
  currentRoute: 'home' | 'browse' | 'detail' | 'watch' | 'profile' | 'manga' | 'schedule' | 'favorites' | 'manga-detail' | 'reader' | 'signin' | 'signup' | 'admin';
  selectedAnimeId: number | null;
  selectedEpisodeNumber: number;
  selectedMangaId?: number | null;
  selectedChapterNumber?: number;
  profileTab: 'profile' | 'continue' | 'favorites' | 'notifications' | 'connections' | 'settings';
  browseFilter?: {
    type?: 'ANIME' | 'MANGA';
    genre?: string;
    search?: string;
  };
}

interface ToastMessage {
  id: string;
  title: string;
  message: string;
  type?: 'info' | 'success' | 'warning';
}

interface AppContextType {
  nav: NavigationState;
  navigateToHome: () => void;
  navigateToBrowse: (filter?: NavigationState['browseFilter']) => void;
  navigateToDetail: (animeId: number) => void;
  navigateToWatch: (animeId: number, episodeNumber?: number) => void;
  navigateToProfile: (tab?: NavigationState['profileTab']) => void;
  navigateToManga: () => void;
  navigateToSchedule: () => void;
  navigateToFavorites: () => void;
  navigateToMangaDetail: (mangaId: number) => void;
  navigateToReader: (mangaId: number, chapterNumber?: number) => void;
  navigateToSignIn: () => void;
  navigateToSignUp: () => void;
  navigateToAdmin: () => void;
  isAuthenticated: boolean;
  authModalOpen: boolean;
  authModalMode: 'create-account' | 'sign-in';
  openAuthModal: (mode?: 'create-account' | 'sign-in') => void;
  closeAuthModal: () => void;
  login: (profile?: Partial<UserProfile>) => void;
  registerUser: (data: { fullName?: string; username?: string; email: string; password?: string }) => void;
  logout: () => void;
  resetToCleanState: () => void;
  favorites: number[];
  toggleFavorite: (animeId: number) => void;
  isFavorited: (animeId: number) => boolean;
  continueWatching: WatchProgress[];
  updateWatchProgress: (progress: WatchProgress) => void;
  userProfile: UserProfile | null;
  updateUserProfile: (profile: Partial<UserProfile>) => void;
  userSettings: UserSettings;
  updateUserSettings: (settings: Partial<UserSettings>) => void;
  comments: Record<string, CommentItem[]>;
  addComment: (animeId: number, episodeNumber: number, content: string) => void;
  searchOpen: boolean;
  setSearchOpen: (open: boolean) => void;
  toast: ToastMessage | null;
  showToast: (title: string, message: string, type?: ToastMessage['type']) => void;
  dismissToast: () => void;
  bookmarkedAnimes: number[];
  toggleBookmark: (animeId: number) => void;
}

const defaultProfileTemplate: UserProfile = {
  id: 'usr_new',
  fullName: 'Anime Enthusiast',
  username: 'MiraiFan',
  email: 'user@mirai.app',
  isEmailVerified: true,
  avatarUrl: '',
  memberSince: 'October 2026',
  level: 1,
  rankTitle: 'Newcomer',
  episodesRemainingToNextLevel: 20,
  totalEpisodesWatched: 0,
  tempDiscordPassword: '',
};

const defaultSettings: UserSettings = {
  autoPlayNext: true,
  autoPlayPageLoad: false,
  autoSkipIntro: true,
  enableDubAudio: false,
  preferOriginalAudio: true,
  showLiveWatchStatus: true,
  showCommentsOnHome: true,
  publicWatchlist: false,
  titleLanguage: 'English',
  discordConnected: true,
  ignoreFolders: ['Plan to Watch', 'Completed'],
  ignoreAudioType: 'None',
  readerDirection: 'vertical',
  readerFit: 'fit-width',
};

const initialContinueWatching: WatchProgress[] = [
  {
    animeId: 21,
    animeTitle: 'ONE PIECE',
    animeCover: 'https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=500&q=80',
    episodeNumber: 1,
    episodeTitle: "I'm Luffy! The Man Who Will Become the Pirate King!",
    progressSeconds: 780,
    totalDurationSeconds: 1440,
    totalEpisodes: 1120,
    lastWatchedAt: '2026-10-30',
  },
  {
    id: 154587,
    animeId: 154587,
    animeTitle: "Frieren: Beyond Journey's End",
    animeCover: 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=500&q=80',
    episodeNumber: 2,
    episodeTitle: "It Didn't Have to Be Magic...",
    progressSeconds: 1100,
    totalDurationSeconds: 1440,
    totalEpisodes: 28,
    lastWatchedAt: '2026-10-29',
  } as any,
  {
    animeId: 171016,
    animeTitle: 'DAN DA DAN',
    animeCover: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=500&q=80',
    episodeNumber: 1,
    episodeTitle: "That's How Love Starts, You Know!",
    progressSeconds: 420,
    totalDurationSeconds: 1440,
    totalEpisodes: 12,
    lastWatchedAt: '2026-10-28',
  },
  {
    animeId: 142838,
    animeTitle: 'Bleach: Thousand-Year Blood War',
    animeCover: 'https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?auto=format&fit=crop&w=500&q=80',
    episodeNumber: 1,
    episodeTitle: 'The Blood Warfare',
    progressSeconds: 1320,
    totalDurationSeconds: 1440,
    totalEpisodes: 366,
    lastWatchedAt: '2026-10-27',
  },
];

const AppContext = createContext<AppContextType | undefined>(undefined);

export const AppProvider: React.FC<{ children: ReactNode }> = ({ children }) => {
  const [nav, setNav] = useState<NavigationState>(() => {
    const isDirectAdmin =
      typeof window !== 'undefined' &&
      (window.location.pathname === '/admin' || window.location.hash === '#admin');

    return {
      currentRoute: isDirectAdmin ? 'admin' : 'home',
      selectedAnimeId: 110349, // Cyberpunk Edgerunners
      selectedEpisodeNumber: 1,
      profileTab: 'profile',
    };
  });

  const [authModalOpen, setAuthModalOpen] = useState(false);
  const [authModalMode, setAuthModalMode] = useState<'create-account' | 'sign-in'>('create-account');

  const [userProfile, setUserProfile] = useState<UserProfile | null>(() => {
    try {
      const saved = localStorage.getItem('mirai_auth_user');
      return saved ? JSON.parse(saved) : null;
    } catch {
      return null;
    }
  });

  const isAuthenticated = userProfile !== null;

  const [favorites, setFavorites] = useState<number[]>(() => {
    try {
      const saved = localStorage.getItem('mirai_favorites');
      return saved ? JSON.parse(saved) : [];
    } catch {
      return [];
    }
  });

  const [bookmarkedAnimes, setBookmarkedAnimes] = useState<number[]>(() => {
    try {
      const saved = localStorage.getItem('mirai_bookmarks');
      return saved ? JSON.parse(saved) : [];
    } catch {
      return [];
    }
  });

  const [continueWatching, setContinueWatching] = useState<WatchProgress[]>(() => {
    try {
      const saved = localStorage.getItem('mirai_continue_watching');
      return saved ? JSON.parse(saved) : [];
    } catch {
      return [];
    }
  });

  const [userSettings, setUserSettings] = useState<UserSettings>(() => {
    try {
      const saved = localStorage.getItem('mirai_settings');
      return saved ? JSON.parse(saved) : defaultSettings;
    } catch {
      return defaultSettings;
    }
  });

  const [comments, setComments] = useState<Record<string, CommentItem[]>>(() => {
    try {
      const saved = localStorage.getItem('mirai_comments');
      return saved ? JSON.parse(saved) : {};
    } catch {
      return {};
    }
  });

  const [searchOpen, setSearchOpen] = useState(false);
  const [toast, setToast] = useState<ToastMessage | null>(null);

  // Keyboard shortcut '/' handler
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (
        e.key === '/' &&
        !['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement).tagName)
      ) {
        e.preventDefault();
        setSearchOpen(true);
      }
      if (e.key === 'Escape') {
        setSearchOpen(false);
      }
    };

    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, []);

  // Listen for browser URL popstate (e.g. /admin navigation)
  useEffect(() => {
    const handlePopState = () => {
      if (window.location.pathname === '/admin' || window.location.hash === '#admin') {
        setNav(prev => ({ ...prev, currentRoute: 'admin' }));
      }
    };
    window.addEventListener('popstate', handlePopState);
    return () => window.removeEventListener('popstate', handlePopState);
  }, []);

  const showToast = (title: string, message: string, type: ToastMessage['type'] = 'info') => {
    const id = Math.random().toString(36).substring(7);
    setToast({ id, title, message, type });
    setTimeout(() => {
      setToast(curr => (curr?.id === id ? null : curr));
    }, 5000);
  };

  const dismissToast = () => setToast(null);

  const navigateToHome = () => {
    try {
      if (window.location.pathname === '/admin') {
        window.history.pushState(null, '', '/');
      }
    } catch {}
    setNav({
      currentRoute: 'home',
      selectedAnimeId: null,
      selectedEpisodeNumber: 1,
      profileTab: 'profile',
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const navigateToBrowse = (filter?: NavigationState['browseFilter']) => {
    setNav({
      currentRoute: filter?.type === 'MANGA' ? 'manga' : 'browse',
      selectedAnimeId: null,
      selectedEpisodeNumber: 1,
      profileTab: 'profile',
      browseFilter: filter,
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const navigateToDetail = (animeId: number) => {
    setNav({
      currentRoute: 'detail',
      selectedAnimeId: animeId,
      selectedEpisodeNumber: 1,
      profileTab: 'profile',
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const navigateToWatch = (animeId: number, episodeNumber: number = 1) => {
    setNav({
      currentRoute: 'watch',
      selectedAnimeId: animeId,
      selectedEpisodeNumber: episodeNumber,
      profileTab: 'profile',
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const navigateToProfile = (tab: NavigationState['profileTab'] = 'profile') => {
    setNav(prev => ({
      ...prev,
      currentRoute: 'profile',
      profileTab: tab,
    }));
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const navigateToManga = () => {
    setNav({
      currentRoute: 'manga',
      selectedAnimeId: null,
      selectedEpisodeNumber: 1,
      profileTab: 'profile',
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const navigateToSchedule = () => {
    setNav({
      currentRoute: 'schedule',
      selectedAnimeId: null,
      selectedEpisodeNumber: 1,
      profileTab: 'profile',
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const navigateToFavorites = () => {
    setNav({
      currentRoute: 'favorites',
      selectedAnimeId: null,
      selectedEpisodeNumber: 1,
      profileTab: 'favorites',
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const navigateToMangaDetail = (mangaId: number) => {
    setNav({
      currentRoute: 'manga-detail',
      selectedAnimeId: null,
      selectedMangaId: mangaId,
      selectedEpisodeNumber: 1,
      profileTab: 'profile',
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const navigateToReader = (mangaId: number, chapterNumber: number = 1) => {
    setNav({
      currentRoute: 'reader',
      selectedAnimeId: null,
      selectedMangaId: mangaId,
      selectedChapterNumber: chapterNumber,
      selectedEpisodeNumber: 1,
      profileTab: 'profile',
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const navigateToSignIn = () => {
    setNav({
      currentRoute: 'signin',
      selectedAnimeId: null,
      selectedEpisodeNumber: 1,
      profileTab: 'profile',
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const navigateToSignUp = () => {
    setNav({
      currentRoute: 'signup',
      selectedAnimeId: null,
      selectedEpisodeNumber: 1,
      profileTab: 'profile',
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const navigateToAdmin = () => {
    try {
      window.history.pushState(null, '', '/admin');
    } catch {}
    setNav({
      currentRoute: 'admin',
      selectedAnimeId: null,
      selectedEpisodeNumber: 1,
      profileTab: 'profile',
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const toggleFavorite = (animeId: number) => {
    setFavorites(prev => {
      const next = prev.includes(animeId) ? prev.filter(id => id !== animeId) : [...prev, animeId];
      try {
        localStorage.setItem('mirai_favorites', JSON.stringify(next));
      } catch {}
      return next;
    });
  };

  const isFavorited = (animeId: number) => favorites.includes(animeId);

  const toggleBookmark = (animeId: number) => {
    setBookmarkedAnimes(prev => {
      const next = prev.includes(animeId) ? prev.filter(id => id !== animeId) : [...prev, animeId];
      try {
        localStorage.setItem('mirai_bookmarks', JSON.stringify(next));
      } catch {}
      return next;
    });
  };

  const updateWatchProgress = (progress: WatchProgress) => {
    setContinueWatching(prev => {
      const filtered = prev.filter(p => p.animeId !== progress.animeId);
      const next = [progress, ...filtered];
      try {
        localStorage.setItem('mirai_continue_watching', JSON.stringify(next));
      } catch {}
      return next;
    });
  };

  const openAuthModal = (mode: 'create-account' | 'sign-in' = 'create-account') => {
    setAuthModalMode(mode);
    setAuthModalOpen(true);
  };

  const closeAuthModal = () => {
    setAuthModalOpen(false);
  };

  const login = (customProfile?: Partial<UserProfile>) => {
    const newProfile: UserProfile = {
      ...defaultProfileTemplate,
      id: 'usr_' + Math.random().toString(36).substring(2, 9),
      username: customProfile?.username || 'MiraiFan',
      email: customProfile?.email || 'fan@mirai.app',
      avatarUrl: customProfile?.avatarUrl || '',
      memberSince: 'October 2026',
      level: 1,
      rankTitle: 'Newcomer',
      episodesRemainingToNextLevel: 20,
      totalEpisodesWatched: 0,
      ...customProfile,
    };
    setUserProfile(newProfile);
    try {
      localStorage.setItem('mirai_auth_user', JSON.stringify(newProfile));
    } catch {}
    setAuthModalOpen(false);
    showToast('Welcome!', `Logged in as ${newProfile.username}`, 'success');
  };

  const registerUser = (data: { fullName?: string; username?: string; email: string; password?: string }) => {
    const displayName = data.fullName?.trim() || data.username || data.email.split('@')[0] || 'MiraiFan';
    const handle = data.username || data.fullName?.toLowerCase().replace(/\s+/g, '_') || data.email.split('@')[0];
    login({
      fullName: data.fullName,
      username: handle,
      email: data.email,
      rankTitle: 'Newcomer',
      memberSince: 'October 2026',
    });

    // Synchronize to backend User Management
    fetch('/api/auth/register-sync', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        fullName: data.fullName,
        username: handle,
        email: data.email,
      }),
    }).catch(() => {});

    navigateToHome();
    showToast('Account Created', `Welcome to MIRAI, ${displayName}!`, 'success');
  };

  const logout = () => {
    setUserProfile(null);
    try {
      localStorage.removeItem('mirai_auth_user');
    } catch {}
    setAuthModalOpen(false);
    navigateToHome();
    showToast('Signed Out', 'You have been returned to the signed-out state', 'info');
  };

  const resetToCleanState = () => {
    try {
      localStorage.removeItem('mirai_auth_user');
      localStorage.removeItem('mirai_favorites');
      localStorage.removeItem('mirai_bookmarks');
      localStorage.removeItem('mirai_continue_watching');
      localStorage.removeItem('mirai_comments');
      localStorage.removeItem('mirai_settings');
    } catch {}
    setUserProfile(null);
    setFavorites([]);
    setBookmarkedAnimes([]);
    setContinueWatching([]);
    setComments({});
    setUserSettings(defaultSettings);
    navigateToHome();
    showToast('Reset Complete', 'App reset to initial guest state', 'info');
  };

  const updateUserProfile = (profileUpdate: Partial<UserProfile>) => {
    setUserProfile(prev => {
      if (!prev) return null;
      const next = { ...prev, ...profileUpdate };
      try {
        localStorage.setItem('mirai_auth_user', JSON.stringify(next));
      } catch {}
      return next;
    });
  };

  const updateUserSettings = (settingsUpdate: Partial<UserSettings>) => {
    setUserSettings(prev => {
      const next = { ...prev, ...settingsUpdate };
      try {
        localStorage.setItem('mirai_settings', JSON.stringify(next));
      } catch {}
      return next;
    });
  };

  const addComment = (animeId: number, episodeNumber: number, content: string) => {
    const key = `${animeId}_${episodeNumber}`;
    const newComment: CommentItem = {
      id: Math.random().toString(36).substring(7),
      episodeNumber,
      authorName: userProfile?.username || 'Guest',
      authorAvatar: userProfile?.avatarUrl || '',
      content,
      createdAt: 'Just now',
      likes: 0,
    };

    setComments(prev => {
      const next = {
        ...prev,
        [key]: [newComment, ...(prev[key] || [])],
      };
      try {
        localStorage.setItem('mirai_comments', JSON.stringify(next));
      } catch {}
      return next;
    });
  };

  return (
    <AppContext.Provider
      value={{
        nav,
        navigateToHome,
        navigateToBrowse,
        navigateToDetail,
        navigateToWatch,
        navigateToProfile,
        navigateToManga,
        navigateToSchedule,
        navigateToFavorites,
        navigateToMangaDetail,
        navigateToReader,
        navigateToSignIn,
        navigateToSignUp,
        navigateToAdmin,
        isAuthenticated,
        authModalOpen,
        authModalMode,
        openAuthModal,
        closeAuthModal,
        login,
        registerUser,
        logout,
        resetToCleanState,
        favorites,
        toggleFavorite,
        isFavorited,
        continueWatching,
        updateWatchProgress,
        userProfile,
        updateUserProfile,
        userSettings,
        updateUserSettings,
        comments,
        addComment,
        searchOpen,
        setSearchOpen,
        toast,
        showToast,
        dismissToast,
        bookmarkedAnimes,
        toggleBookmark,
      }}
    >
      {children}
    </AppContext.Provider>
  );
};

export const useApp = () => {
  const context = useContext(AppContext);
  if (!context) {
    throw new Error('useApp must be used within an AppProvider');
  }
  return context;
};
