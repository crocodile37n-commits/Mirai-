// ==========================================
// 11. PUBLIC CLIENT-SIDE APIs FOR MIRAI
// ==========================================

// Ingest real analytics event from frontend
app.post('/api/analytics/event', (req: Request, res: Response) => {
  const { type, path, targetId, targetTitle, category, metadata } = req.body;
  if (!type || !path) {
    return res.status(400).json({ error: 'type and path are required' });
  }

  const ipHash = hashIp(req);
  db.addAnalyticsEvent({
    type,
    path,
    targetId,
    targetTitle,
    category,
    metadata,
    ipHash,
  });

  res.status(201).json({ status: 'recorded' });
});

// Sync registration event so user appears in admin panel
app.post('/api/auth/register-sync', (req: Request, res: Response) => {
  const { fullName, username, email, favoriteGenres } = req.body;
  if (!email) return res.status(400).json({ error: 'email required' });

  const user = db.registerUser({
    fullName: fullName || username || 'Mirai Member',
    username: username || email.split('@')[0],
    email: email.trim().toLowerCase(),
    favoriteGenres: favoriteGenres || ['Action', 'Fantasy'],
  });

  res.json({ success: true, user });
});

// Public announcements (only enabled & valid date)
app.get('/api/public/announcements', (_req: Request, res: Response) => {
  const all = db.getAnnouncements();
  const active = all.filter((a) => a.enabled);
  res.json({ announcements: active });
});

// Public donation campaign (only if enabled)
app.get('/api/public/donations', (_req: Request, res: Response) => {
  const campaign = db.getDonationCampaign();
  res.json({ donation: campaign });
});

// Public ads (empty unless globalEnabled is true)
app.get('/api/public/ads', (_req: Request, res: Response) => {
  const ads = db.getAds();
  if (!ads.globalEnabled) {
    return res.json({ enabled: false, campaigns: [] });
  }
  const active = ads.campaigns.filter((c) => c.enabled);
  res.json({ enabled: true, campaigns: active });
});

// Public site settings
app.get('/api/public/settings', (_req: Request, res: Response) => {
  const settings = db.getSettings();
  res.json({
    websiteName: settings.websiteName,
    maintenanceMode: settings.maintenanceMode,
    maintenanceNotice: settings.maintenanceNotice,
    allowRegistrations: settings.allowRegistrations,
  });
});

// ==========================================
// 12. STATIC / VITE INTEGRATION
// ==========================================

async function startServer() {
  if (!isProduction) {
    const vite = await createViteServer({
      server: { middlewareMode: true },
      appType: 'spa',
    });
    app.use(vite.middlewares);
  } else {
    const distPath = path.resolve('dist');
    app.use(express.static(distPath));
    app.get('*', (_req: Request, res: Response) => {
      res.sendFile(path.join(distPath, 'index.html'));
    });
  }

  app.listen(Number(PORT), '0.0.0.0', () => {
    console.log(`MIRAI Full-Stack Server running at http://0.0.0.0:${PORT}`);
  });
}

startServer().catch((err) => {
  console.error('Failed to start server:', err);
});
