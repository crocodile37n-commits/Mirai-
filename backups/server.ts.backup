// ==========================================
// 8. REVENUE & EARNINGS
// ==========================================

app.get('/api/admin/revenue', requireAdmin, (_req: Request, res: Response) => {
  const ads = db.getAds();
  const donation = db.getDonationCampaign();

  const confirmedDonations = donation.verifiedDonationAmount || 0;
  const estimatedAdRevenue = ads.globalEnabled
    ? ads.campaigns.reduce((acc, c) => acc + (c.estimatedEarnings || 0), 0)
    : 0;

  res.json({
    adsEnabled: ads.globalEnabled,
    confirmedDonationRevenue: confirmedDonations,
    estimatedAdRevenue: estimatedAdRevenue,
    donationCount: donation.totalDonationCount || 0,
    hasIntegratedGateway: false,
    notice: ads.globalEnabled
      ? 'Advertising is currently enabled.'
      : 'All advertisements are currently disabled by default. No ad revenue is generated until campaigns are configured and enabled.',
  });
});

// ==========================================
// 9. CONTENT MANAGEMENT (Anime & Manga)
// ==========================================

app.get('/api/admin/content', requireAdmin, (_req: Request, res: Response) => {
  const overrides = db.getContentOverrides();
  res.json({
    anime: FALLBACK_SPOTLIGHT.concat(FALLBACK_TRENDING.slice(4)),
    manga: MANGA_DIRECTORY_POOL,
    overrides,
  });
});

app.post('/api/admin/content/toggle-visibility', requireAdmin, (req: Request, res: Response) => {
  const { type, id, hide } = req.body;
  if (type === 'anime') {
    db.toggleAnimeVisibility(Number(id), Boolean(hide));
  } else {
    db.toggleMangaVisibility(Number(id), Boolean(hide));
  }
  res.json({ success: true, overrides: db.getContentOverrides() });
});

app.post('/api/admin/content/toggle-featured', requireAdmin, (req: Request, res: Response) => {
  const { type, id, feature } = req.body;
  if (type === 'anime') {
    db.toggleAnimeFeatured(Number(id), Boolean(feature));
  } else {
    db.toggleMangaFeatured(Number(id), Boolean(feature));
  }
  res.json({ success: true, overrides: db.getContentOverrides() });
});

